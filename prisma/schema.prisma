generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EmailWhitelist {
  id          String   @id @default(uuid()) @db.Uuid
  nama        String
  email       String   @unique
  isActive    Boolean  @default(true)
  jabatan     Jabatan
  role        Role
  addedBy     String?  @db.Uuid
  addedByUser Profile? @relation("ProfileToEmailWhitelist", fields: [addedBy], references: [id])
  addedAt     DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([email])
  @@index([isActive])
  @@map("email_whitelist")
}

model Profile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String  @unique
  nama                String
  jabatan             Jabatan
  role                Role
  fotoUrl             String?
  phone               String?
  alamat              String?
  is_profile_complete Boolean @default(false)

  addedWhitelist EmailWhitelist[] @relation("ProfileToEmailWhitelist")

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  activities  UserActivity[]
  permissions UserPermission[]

  @@map("profile")
}

enum Jabatan {
  DEVELOPER     @map("DEVELOPER")
  MAINTENANCE   @map("MAINTENANCE")
  KETUA         @map("KETUA")
  SEKRETARIS    @map("SEKRETARIS")
  BENDAHARA     @map("BENDAHARA")
  PENGURUS      @map("PENGURUS")
  HUMAS         @map("HUMAS")
  REMAS         @map("REMAS")
  MAJLIS_TALIM  @map("MAJLIS_TALIM")

  @@map("Jabatan")
}

enum Role {
  ADMIN                 @map("ADMIN")
  KETUA                 @map("KETUA")
  SEKRETARIS            @map("SEKRETARIS")
  BENDAHARA             @map("BENDAHARA")
  PENGURUS              @map("PENGURUS")
  HUMAS_MEDIA           @map("HUMAS_MEDIA")
  REMAS_ADMIN           @map("REMAS_ADMIN")
  MAJLIS_TALIM_ADMIN    @map("MAJLIS_TALIM_ADMIN")

  @@map("Role")
}

model UserActivity {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model UserPermission {
  id         String     @id @default(uuid())
  profileId  String     @db.Uuid
  profile    Profile    @relation(fields: [profileId], references: [id])
  resource   Resource // Menggunakan enum Resource
  permission Permission // Menggunakan enum Permission
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([profileId, resource, permission])
}

enum Resource {
  KEUANGAN
  MANAJEMEN
  KONTEN
  INVENTARIS
  DASHBOARD
  ADMIN
}

enum Permission {
  READ
  WRITE
  DELETE
  APPROVE
}

model Donatur {
  id        Int      @id @default(autoincrement())
  no        Int
  nama      String
  alamat    String
  tahun     Int
  jan       Int      @default(0)
  feb       Int      @default(0)
  mar       Int      @default(0)
  apr       Int      @default(0)
  mei       Int      @default(0)
  jun       Int      @default(0)
  jul       Int      @default(0)
  aug       Int      @default(0)
  sep       Int      @default(0)
  okt       Int      @default(0)
  nov       Int      @default(0)
  des       Int      @default(0)
  infaq     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  konten    Konten[]
}

model KotakAmal {
  id        Int      @id @default(autoincrement())
  no        Int
  nama      String
  lokasi    String
  tahun     Int
  jan       Int      @default(0)
  feb       Int      @default(0)
  mar       Int      @default(0)
  apr       Int      @default(0)
  mei       Int      @default(0)
  jun       Int      @default(0)
  jul       Int      @default(0)
  aug       Int      @default(0)
  sep       Int      @default(0)
  okt       Int      @default(0)
  nov       Int      @default(0)
  des       Int      @default(0)
  createdAt DateTime @default(now())

  konten    Konten[]
}

model KotakAmalMasjid {
  id        Int      @id @default(autoincrement())
  tanggal   DateTime
  jumlah    Int
  tahun     Int
  createdAt DateTime @default(now())
}

model KotakAmalJumat {
  id        Int      @id @default(autoincrement())
  tanggal   DateTime
  jumlah    Int
  tahun     Int
  createdAt DateTime @default(now())
}

model DonasiKhusus {
  id         Int      @id @default(autoincrement())
  no         Int
  nama       String
  tanggal    DateTime
  tahun      Int
  jumlah     Int
  keterangan String
  createdAt  DateTime @default(now())

}

model Pengeluaran {
  id         Int      @id @default(autoincrement())
  no         Int
  tanggal    DateTime
  nama       String
  jumlah     Int
  tahun      Int
  keterangan String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model Pengurus {
  id        Int      @id @default(autoincrement())
  no        Int
  nama      String
  jabatan   String
  periode   String
  kategori  String   @default("MASJID") // MASJID, REMAS, MAJLIS_TALIM
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// Enum untuk kategori konten (menggantikan tabel kategori_konten)
enum KategoriKontenEnum {
  KEGIATAN_MASJID
  PENGUMUMAN
  KAJIAN_RUTIN
  KEGIATAN_TPQ_TPA
  LOMBA_ACARA
  RAMADHAN
  IDUL_FITRI
  IDUL_ADHA
  BAKTI_SOSIAL
}

// Model utama untuk konten masjid
model Konten {
  id                 Int          @id @default(autoincrement())
  judul              String
  slug               String       @unique
  deskripsi          String
  tanggal            DateTime
  waktu              String?
  lokasi             String?
  penulis            String?
  kategori           KategoriKontenEnum
  donaturId          Int?
  kotakAmalId        Int?
  penting            Boolean      @default(false)
  tampilkanDiBeranda Boolean      @default(true)
  status             StatusKonten @default(PUBLISHED)
  viewCount          Int          @default(0)
  fotoUrl            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now())

  // Kategori sekarang disimpan sebagai enum `KategoriKontenEnum`.
  // Jika Anda membutuhkan relasi dinamis dengan tabel kategori, pertimbangkan
  // untuk tetap menggunakan `KategoriKonten` model dan foreign key.
  donatur    Donatur?          @relation(fields: [donaturId], references: [id])
  kotakAmal  KotakAmal?        @relation(fields: [kotakAmalId], references: [id])
  gambar     GambarKonten[]
  kontenTags KontenTagKonten[]

  @@map("konten")
}

// Model untuk gambar konten
model GambarKonten {
  id        Int      @id @default(autoincrement())
  kontenId  Int
  url       String
  filename  String
  caption   String?
  urutan    Int      @default(0)
  isUtama   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  konten    Konten   @relation(fields: [kontenId], references: [id], onDelete: Cascade)

  @@map("gambar_konten")
}

// Model untuk tag konten
model TagKonten {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  kontenTags KontenTagKonten[]

  @@map("tag_konten")
}

// Junction table untuk many-to-many relation antara Konten dan TagKonten
model KontenTagKonten {
  id        Int      @id @default(autoincrement())
  kontenId  Int
  tagId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relasi
  konten    Konten    @relation(fields: [kontenId], references: [id], onDelete: Cascade)
  tagKonten TagKonten @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Pastikan kombinasi kontenId dan tagId unik
  @@unique([kontenId, tagId])
  @@map("konten_tag_konten")
}

// Enum untuk status konten
enum StatusKonten {
  DRAFT
  PUBLISHED
  ARCHIVED
  REVIEWED
}

// Model untuk konfigurasi website
model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("site_config")
}

enum KategoriInventaris {
  PERLENGKAPAN
  ELEKTRONIK
  KEBERSIHAN
  DOKUMEN
  LAINNYA
}

enum KondisiInventaris {
  BAIK
  CUKUP
  RUSAK
}

enum SatuanInventaris {
  UNIT
  BUAH
  LEMBAR
  SET
  LAINNYA
}

model Inventaris {
  id           Int                @id @default(autoincrement())
  no           Int
  namaBarang   String
  fotoUrl      String?
  kategori     KategoriInventaris
  jumlah       Int
  satuan       SatuanInventaris
  lokasi       String
  kondisi      KondisiInventaris
  tanggalMasuk DateTime
  tahun        Int
  keterangan   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now())
}

model TargetPemasukan {
  id         Int      @id @default(autoincrement())
  tahun      Int
  bulan      Int
  target     BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tahun, bulan])
  @@map("target_pemasukan")
}

enum KategoriOrganisasi {
  PENGURUS_MASJID
  REMAS
  MAJLIS_TALIM
}

model programkerja {
  id            Int                 @id @default(autoincrement())
  kategori      KategoriOrganisasi  // Pengurus Masjid, Remas, atau Majlis Ta'lim
  seksi         String              // Contoh: "Ibadah", "Humas", "Media dan Informasi", dll
  programKerja  String              @db.Text // Deskripsi program kerja langsung (contoh: "Memberdayakan dan membantu...")
  urutan        Int                 @default(1) // Urutan poin (1, 2, 3, dst)
  tahun         Int?                // Tahun program kerja (opsional)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Constraint untuk memastikan tidak ada duplikasi urutan dalam kategori dan seksi yang sama
  @@unique([kategori, seksi, urutan, tahun])
  @@index([kategori, seksi])
}

model LaporanJumatFiles {
  id              String   @id @default(uuid()) @db.Uuid
  tanggal         DateTime @db.Timestamp(3)
  judul           String
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  fileSize        BigInt   @map("file_size")
  isPublic        Boolean  @default(false) @map("is_public")
  uploadedBy      String?  @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamp(3)
  saldoKasAwal    BigInt   @map("saldo_kas_awal")
  totalPemasukan  BigInt   @map("total_pemasukan")
  totalPengeluaran BigInt  @map("total_pengeluaran")
  saldoKasAkhir   BigInt   @map("saldo_kas_akhir")
  khatib          String?
  muadzdzin       String?
  imam            String?
  ketuaPengurus   String?  @map("ketua_pengurus")
  bendahara       String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamp(3)

  @@index([tanggal])
  @@index([isPublic])
  @@index([uploadedAt])
  @@map("laporan_jumat_files")
}

model SiteConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String   @db.Text
  description String?
  category    String   @default("general")
  dataType    String   @default("string") // string, number, boolean, json
  isPublic    Boolean  @default(false)
  updatedBy   String?  @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([isPublic])
  @@map("site_configuration")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  userEmail   String?
  action      String   // CREATE, UPDATE, DELETE
  tableName   String   // Table/model name that was affected
  recordId    String?  // ID of the affected record
  oldValues   Json?    // Previous values (for UPDATE/DELETE)
  newValues   Json?    // New values (for CREATE/UPDATE)
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  description String?  // Human readable description

  @@index([userId])
  @@index([tableName])
  @@index([action])
  @@index([timestamp])
  @@map("audit_log")
}

// Model untuk sistem notifikasi berbasis role
model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  message     String             @db.Text
  type        NotificationType
  priority    NotificationPriority @default(MEDIUM)
  targetRoles Role[]             // Array role yang akan menerima notifikasi
  actionUrl   String?            // URL untuk action button (optional)
  relatedId   String?            // ID record terkait (optional)
  relatedTable String?           // Nama tabel terkait (optional)
  isRead      Boolean            @default(false)
  readBy      String[]           @default([]) // Array user IDs yang sudah membaca
  createdBy   String?            @db.Uuid
  expiresAt   DateTime?          // Notifikasi bisa expired (optional)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
  @@index([priority])
  @@index([targetRoles])
  @@index([isRead])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("notifications")
}

// Enum untuk tipe notifikasi
enum NotificationType {
  TARGET_PEMASUKAN      // Target pemasukan tercapai/tidak tercapai
  DONASI_BARU          // Donasi khusus baru masuk
  KONTEN_BARU          // Konten baru ditambahkan
  INVENTARIS_BARU      // Inventaris baru ditambahkan
  SYSTEM_HEALTH        // System health warning
  EMAIL_WHITELIST      // Email whitelist baru ditambahkan
  GENERAL              // Notifikasi umum
}

// Enum untuk prioritas notifikasi
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Model untuk menyimpan data pengunjung harian dari Cloudflare
model DailyVisitorData {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  visitors  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_visitor_data")
}
